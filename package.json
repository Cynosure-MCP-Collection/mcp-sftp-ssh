{
  "name": "@cynosure-mcp/sftp-ssh",
  "mcpName": "io.github.andreasjhagen/sftp-ssh",
  "version": "1.0.0",
  "description": "MCP server for SFTP file operations and SSH command execution",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sftp-ssh": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "release:check": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add server.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ssh2": "^1.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "server.json",
    "icon.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sftp",
    "ssh",
    "remote-files",
    "remote-shell"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-sftp-ssh.git"
  },
  "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-sftp-ssh#readme",
  "bugs": {
    "url": "https://github.com/Cynosure-MCP-Collection/mcp-sftp-ssh/issues"
  }
}
